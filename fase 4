        ttk.Button(botones, text="Run Demonstration of 13 Operations", command=self.demostracion).pack(side="left", padx=10)

    def actualizar_logs(self):
        self.texto_logs.configure(state="normal")
        self.texto_logs.delete("1.0", tk.END)
        try:
            with open("software_fj.log", "r", encoding="utf-8") as archivo:
                contenido = archivo.read()
                self.texto_logs.insert(tk.END, contenido)
        except FileNotFoundError:
            self.texto_logs.insert(tk.END, "No records yet.")
        except OSError as error:
            logger.exception("Could not read log file.")
            self.texto_logs.insert(tk.END, f"Error reading logs: {error}")
        finally:
            self.texto_logs.configure(state="disabled")

