# =====================================================
# 3.  Clase  Abstracta Entidad 
# =====================================================

class Entidad(ABC):

    def __init__(self, identificador):
        self._identificador = identificador

    @property
    def identificador(self):
        return self._identificador

    @abstractmethod
    def describir(self):
        pass

# =====================================================
# 4. Clase Cliente
# =====================================================

class Cliente(Entidad):

    def __init__(self, nombre, correo, telefono):
        super().__init__(str(uuid.uuid4())[:8])
        self.__nombre = self.validar_texto(nombre, "name")
        self.__correo = self.validar_correo(correo)
        self.__telefono = self.validar_telefono(telefono)

    @staticmethod
    def validar_texto(valor, campo):
        if not isinstance(valor, str) or not valor.strip():
            raise DatosInvalidosError(f"The {campo} field cannot be empty.")
        return valor.strip()

    @staticmethod
    def validar_correo(correo):
        if not isinstance(correo, str):
            raise DatosInvalidosError("Email must be text.")
        correo = correo.strip()
        if "@" not in correo or "." not in correo.split("@")[-1]:
            raise DatosInvalidosError("The email address is not valid.")
        return correo

    @staticmethod
    def validar_telefono(telefono):
        telefono = str(telefono).strip()
        if not telefono.isdigit() or len(telefono) < 7:
            raise DatosInvalidosError("The phone number is not valid.")
        return telefono

    @property
    def nombre(self):
        return self.__nombre

    @property
    def correo(self):
        return self.__correo

    @property
    def telefono(self):
        return self.__telefono

    def describir(self):
        return f"Client: {self.__nombre} | Email: {self.__correo} | Phone: {self.__telefono}"

# =====================================================
# 5. Clase Abstracta Servicio 
# =====================================================

class Servicio(Entidad, ABC):

    def __init__(self, nombre, precio):
        super().__init__(str(uuid.uuid4())[:8])
        if not isinstance(precio, (int, float)) or isinstance(precio, bool) or precio <= 0:
            raise DatosInvalidosError("Price must be greater than zero.")
        self._nombre = nombre
        self._precio = float(precio)
        self._disponible = True

    @property
    def nombre(self):
        return self._nombre

    @property
    def precio(self):
        return self._precio

    @property
    def disponible(self):
        return self._disponible

    def cambiar_disponibilidad(self, estado):
        if not isinstance(estado, bool):
            raise DatosInvalidosError("Availability must be true or false.")
        self._disponible = estado

    def validar_parametros(self, duracion):
        if not isinstance(duracion, (int, float)):
            raise DatosInvalidosError("Duration must be numeric.")
        if isinstance(duracion, bool) or duracion <= 0:
            raise DatosInvalidosError("Duration must be greater than zero.")

    # Overloading with default arguments:
    # calcular_costo(duracion)
    # calcular_costo(duracion, impuesto)
    # calcular_costo(duracion, impuesto, descuento)

    def calcular_costo(self, duracion, impuesto=0, descuento=0):
        self.validar_parametros(duracion)
        if not isinstance(impuesto, (int, float)) or isinstance(impuesto, bool):
            raise DatosInvalidosError("Tax must be numeric.")
        if not isinstance(descuento, (int, float)) or isinstance(descuento, bool):
            raise DatosInvalidosError("Discount must be numeric.")
        if not 0 <= impuesto <= 100:
            raise DatosInvalidosError("Tax must be between 0 and 100.")
        if not 0 <= descuento <= 100:
            raise DatosInvalidosError("Discount must be between 0 and 100.")
        subtotal = self._precio * duracion
        valor_descuento = subtotal * descuento / 100
        total = (subtotal - valor_descuento) * (1 + impuesto / 100)
        return round(total, 2)

    @abstractmethod
    def describir(self):
        pass

    @abstractmethod
    def validar_servicio(self, duracion):
        pass

