    def actualizar_clientes(self):
        self.combo_cliente["values"] = [f"{c.identificador} - {c.nombre}" for c in self.gestor.listar_clientes()]

    def crear_reserva(self):
        try:
            seleccion_cliente = self.combo_cliente.get()
            if not seleccion_cliente:
                raise DatosInvalidosError("You must select a client.")
            identificador = seleccion_cliente.split(" - ")[0]
            cliente = self.gestor.buscar_cliente(identificador)
            nombre_servicio = self.combo_servicio.get()
            servicio = next((s for s in self.gestor.servicios if s.nombre == nombre_servicio), None)
            if servicio is None:
                raise ServicioNoDisponibleError("You must select a valid service.")
            try:
                duracion = float(self.duracion.get())
            except ValueError as error:
                raise DatosInvalidosError("Duration must be a number.") from error
            reserva = self.gestor.crear_reserva(cliente, servicio, duracion)
        except Exception as error:
            logger.exception("Error in reservation form.")
            messagebox.showerror("Error", str(error))
        else:
            self.lista_reservas.insert(tk.END, reserva.describir())
            self.duracion.delete(0, tk.END)
            messagebox.showinfo("Reservation Created", "The reservation was created successfully.")
        finally:
            self.actualizar_logs()

    def obtener_reserva_seleccionada(self):
        seleccion = self.lista_reservas.curselection()
        if not seleccion:
            raise ReservaInvalidaError("Select a reservation from the list.")
        return self.gestor.reservas[seleccion[0]], seleccion[0]

