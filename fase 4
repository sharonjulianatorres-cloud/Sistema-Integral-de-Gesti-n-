            self.lista_reservas.delete(0, tk.END)
            for reserva in self.gestor.reservas:
                self.lista_reservas.insert(tk.END, reserva.describir())
            messagebox.showinfo("Demonstration Finished", "13 test operations were executed.\nCheck the console and the software_fj.log file.")
        except Exception as error:
            logger.exception("General error in demonstration.")
            messagebox.showerror("Error", str(error))
        finally:
            self.actualizar_logs()

