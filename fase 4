# =====================================================
# 9. Clase Reserva
# =====================================================

class Reserva(Entidad):

    def __init__(self, cliente, servicio, duracion):
        super().__init__(str(uuid.uuid4())[:8])
        if not isinstance(cliente, Cliente):
            raise DatosInvalidosError("You must select a valid client.")
        if not isinstance(servicio, Servicio):
            raise DatosInvalidosError("You must select a valid service.")
        servicio.validar_servicio(duracion)
        if not servicio.disponible:
            raise ServicioNoDisponibleError("The selected service is not available.")
        self.__cliente = cliente
        self.__servicio = servicio
        self.__duracion = duracion
        self.__estado = "Pending"
        self.__fecha = datetime.now().strftime("%d/%m/%Y %H:%M")

    @property
    def cliente(self):
        return self.__cliente

    @property
    def servicio(self):
        return self.__servicio

    @property
    def duracion(self):
        return self.__duracion

    @property
    def estado(self):
        return self.__estado

    def confirmar(self):
        if self.__estado != "Pending":
            raise OperacionNoPermitidaError("Only pending reservations can be confirmed.")
        if not self.__servicio.disponible:
            raise ServicioNoDisponibleError("The service is no longer available.")
        self.__estado = "Confirmed"
        logger.info(f"Reservation {self.identificador} confirmed.")

    def cancelar(self):
        if self.__estado == "Cancelled":
            raise OperacionNoPermitidaError("The reservation is already cancelled.")
        self.__estado = "Cancelled"
        logger.info(f"Reservation {self.identificador} cancelled.")

    def procesar(self, impuesto=19, descuento=0):
        try:
            if self.__estado != "Confirmed":
                raise OperacionNoPermitidaError("The reservation must be confirmed to be processed.")
            total = self.__servicio.calcular_costo(self.__duracion, impuesto, descuento)
            if total < 0:
                raise ErrorSistema("Cost calculation is inconsistent.")
            return total
        except Exception as error:
            logger.exception("Error while processing the reservation.")
            raise ErrorSistema("It was not possible to process the reservation.") from error
        finally:
            logger.info(f"Finished processing attempt for reservation {self.identificador}.")

    def describir(self):
        return f"Reservation: {self.identificador} | Client: {self.cliente.nombre} | Service: {self.servicio.nombre} | Duration: {self.duracion} hours | Status: {self.estado}"

# =====================================================
# 10. Clase Gestor de Sistema
# =====================================================

class GestorSistema:
    def __init__(self):
        self.clientes = []
        self.servicios = [ReservaSala(), AlquilerEquipos(), AsesoriaEspecializada()]
        self.reservas = []

    def registrar_cliente(self, cliente):
        if not isinstance(cliente, Cliente):
            raise DatosInvalidosError("The client is not valid.")
        if any(c.correo.lower() == cliente.correo.lower() for c in self.clientes):
            raise DatosInvalidosError("The email is already registered.")
        self.clientes.append(cliente)
        logger.info(f"Client registered: {cliente.nombre}")
        return cliente

    def buscar_cliente(self, identificador):
        for cliente in self.clientes:
            if cliente.identificador == identificador:
                return cliente
        raise ClienteNoEncontradoError("Client not found.")

    def crear_reserva(self, cliente, servicio, duracion):
        try:
            reserva = Reserva(cliente, servicio, duracion)
            self.reservas.append(reserva)
            logger.info(f"Reservation created: {reserva.identificador}")
            return reserva
        except Exception as error:
            logger.exception("Error creating a reservation.")
            raise ReservaInvalidaError("It was not possible to create the reservation.") from error

    def listar_clientes(self):
        return self.clientes

    def listar_servicios(self):
        return self.servicios

    def listar_reservas(self):
        return self.reservas

# =====================================================
# 11. Demostracion de las 13 operaciones
# =====================================================

def ejecutar_demostracion(gestor):
    print("\n========== SOFTWARE FJ DEMONSTRATION ==========\n")
    operaciones = 0

    def ejecutar(nombre, funcion):
        nonlocal operaciones
        operaciones += 1
        print(f"\nOPERATION {operaciones}: {nombre}")
        try:
            resultado = funcion()
        except Exception as error:
            logger.exception(f"Operation {operaciones} failed: {nombre}")
            print(f"Controlled error: {error}")
        else:
            print("Result:", resultado)
        finally:
            print("Operation finished.")

    ejecutar("Valid client registration", lambda: gestor.registrar_cliente(Cliente("Carlos Perez", "carlos@gmail.com", "3001234567")).describir())
    ejecutar("Second client registration", lambda: gestor.registrar_cliente(Cliente("Laura Gomez", "laura@gmail.com", "3017654321")).describir())
    ejecutar("Client registration without name", lambda: Cliente("", "error@gmail.com", "3001234567"))
    ejecutar("Duplicate email registration", lambda: gestor.registrar_cliente(Cliente("Pedro Ruiz", "carlos@gmail.com", "3101234567")))
    ejecutar("Available services query", lambda: [s.describir() for s in gestor.servicios])
    ejecutar("Room reservation cost calculation", lambda: gestor.servicios[0].calcular_costo(2, 19, 10))
    ejecutar("Calculation with negative duration", lambda: gestor.servicios[1].calcular_costo(-2))

    cliente = gestor.clientes[0]
    ejecutar("Valid reservation creation", lambda: gestor.crear_reserva(cliente, gestor.servicios[0], 2).describir())
    reserva = gestor.reservas[0]
    ejecutar("Reservation confirmation", lambda: confirmar_y_describir(reserva))
    ejecutar("Reservation processing and calculation", lambda: reserva.procesar(19, 5))
    ejecutar("Reservation with incorrect duration", lambda: gestor.crear_reserva(cliente, gestor.servicios[0], 30))
    ejecutar("Reservation cancellation", lambda: cancelar_y_describir(reserva))
    ejecutar("Confirmation of cancelled reservation", lambda: reserva.confirmar())

    print("\n==============================================")
    print(f"Total operations performed: {operaciones}")
    print("The system keeps working.")
    print("Errors were recorded in software_fj.log")
    print("==============================================\n")

def confirmar_y_describir(reserva):
    reserva.confirmar()
    return reserva.describir()

def cancelar_y_describir(reserva):
    reserva.cancelar()
    return reserva.describir()

