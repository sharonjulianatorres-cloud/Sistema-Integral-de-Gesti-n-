            messagebox.showerror("Error", str(error))
        else:
            self.actualizar_reserva_visual(reserva, indice)
            messagebox.showinfo("Success", "Reservation confirmed.")
        finally:
            self.actualizar_logs()

    def procesar_reserva(self):
        try:
            reserva, indice = self.obtener_reserva_seleccionada()
            total = reserva.procesar(19, 0)
        except Exception as error:
            logger.exception("Error processing reservation.")
            messagebox.showerror("Error", str(error))
        else:
            messagebox.showinfo("Processing Successful", f"The total value of the reservation is:\n${total:,.2f}")
        finally:
            self.actualizar_logs()

    def cancelar_reserva(self):
        try:
            reserva, indice = self.obtener_reserva_seleccionada()
            reserva.cancelar()
        except Exception as error:
            logger.exception("Error cancelling reservation.")
            messagebox.showerror("Error", str(error))
        else:
            self.actualizar_reserva_visual(reserva, indice)
            messagebox.showinfo("Success", "Reservation cancelled.")
        finally:
            self.actualizar_logs()

